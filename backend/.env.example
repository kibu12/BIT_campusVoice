# =================================================================
# BIT CAMPUSVOICE — ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS TO VERSION CONTROL.
# Copy this file to .env and configure real credentials securely.
# =================================================================

# Environment runtime mode ("development" or "production")
ENVIRONMENT=development

# Network Server Binding
HOST=0.0.0.0
PORT=8000

# Cryptographic Token Signing Secret (MUST BE AT LEAST 32 CHARACTERS)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_32_plus_char_key_here

# Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Institutional Google OpenID Connect Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Administrator Credentials (Use Argon2id Hash)
ADMIN_USERNAME=campus_admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=replace_with_argon2id_hash_of_admin_password

# AI & Knowledge Retrieval API Keys
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Database URL
# Development: sqlite+aiosqlite:///./data/campus_assistant.db
# Production: postgresql+asyncpg://user:password@host:5432/bit_campusvoice?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./data/campus_assistant.db

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://campusvoice.bitsathy.ac.in

# Document Paths
DOCUMENTS_DIR=./data/documents

