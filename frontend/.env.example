# =================================================================
# BIT CAMPUSVOICE — FRONTEND ENVIRONMENT CONFIGURATION
# =================================================================

# API Gateway Base URL
# For local dev without reverse proxy: http://localhost:8000/api
# For production or same-origin reverse proxy (Nginx / Docker Compose): /api
VITE_API_BASE_URL=/api

# Institutional Google OAuth Client ID (must match GOOGLE_CLIENT_ID in backend/.env)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

