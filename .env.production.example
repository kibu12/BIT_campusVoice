# =================================================================
# BIT CAMPUSVOICE — PRODUCTION ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env on your production host and configure values.
# Ensure file permissions are restricted (e.g. chmod 600 .env).
# =================================================================

# Environment runtime mode (must be "production")
ENVIRONMENT=production

# Server network binding
HOST=0.0.0.0
PORT=8000

# Cryptographic Token Signing Secret (MUST be at least 32 characters of high-entropy randomness)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_cryptographically_secure_random_jwt_secret_key_min_32_chars

# Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Institutional Google OpenID Connect Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_production_google_oauth_client_id.apps.googleusercontent.com

# Administrator Account Configuration
ADMIN_USERNAME=bit_campus_admin
# Generate hash with: python -c "from argon2 import PasswordHasher; ph = PasswordHasher(time_cost=3, memory_cost=65536, parallelism=4, hash_len=32); print(ph.hash('YourStrongPassword'))"
ADMIN_PASSWORD_HASH=your_argon2id_password_hash_here

# External AI & Knowledge Retrieval API Keys
GROQ_API_KEY=your_production_groq_api_key_here
TAVILY_API_KEY=your_production_tavily_api_key_here

# Database Connection URL
# Supported: SQLite (default for single-instance container) or PostgreSQL with asyncpg
# SQLite: sqlite+aiosqlite:///./data/campus_assistant.db
# PostgreSQL: postgresql+asyncpg://dbuser:dbpassword@dbhost:5432/bit_campusvoice?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./data/campus_assistant.db

# Storage Directories
DOCUMENTS_DIR=./data/documents

# Allowed CORS Origins (comma-separated list of trusted client origins)
ALLOWED_ORIGINS=https://campusvoice.bitsathy.ac.in

# Institutional SMTP Email Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=campusvoice-noreply@bitsathy.ac.in
SMTP_PASSWORD=your_smtp_app_password_here
NOTIFICATION_EMAIL=grievance-cell@bitsathy.ac.in

